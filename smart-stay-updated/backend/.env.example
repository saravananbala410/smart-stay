# ─── DATABASE ────────────────────────────────────────
# Production: use a managed PostgreSQL Internal Database URL.
# Do not use SQLite on an ephemeral cloud web service because redeploys can erase accounts.
# Local PostgreSQL (unna computer la install panna):
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/smartstay

# OR Supabase free cloud DB:
# DATABASE_URL=postgresql://postgres:yourpassword@db.xxxxx.supabase.co:5432/postgres

# ─── JWT SECRET ──────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production
APP_ENV=development

# ─── CLOUDINARY (Free file upload) ──────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── EMAIL (HTTPS provider recommended for cloud hosts) ───────────
# Resend works over HTTPS, including hosts that block outbound SMTP ports.
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Smart Stay <onboarding@resend.dev>

# Optional SMTP fallback for local/paid hosts. Gmail requires a 16-character App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=yourgmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# ─── FRONTEND URL ────────────────────────────────────
FRONTEND_URL=http://localhost:5173
FRONTEND_PUBLIC_URL=http://localhost:5173
BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── PAYMENTS ────────────────────────────────────────
# Admin can configure hostel-specific UPI ID from the Home screen.
# This is only a fallback for existing installations.
UPI_ID=

# ─── SMS / WHATSAPP PROVIDER ─────────────────────────
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
